# Configuração do laboratório. Copie este arquivo para ".env" (ou rode ./iniciar.sh, que faz isso por você).

# Endereço do site do laboratório (sem nada depois). Na rede local da aula: http://192.168.0.158:8765
SERVIDOR=https://scsep.joaopedromagalhaes.com.br

# >>> COLE AQUI O SEU TOKEN DE ATIVAÇÃO <<<
# Onde pegar: site do laboratório > "Meu laboratório" > "Token de ativação" > "Copiar token".
# Começa com "ak_". Sem espaços e sem aspas. Só é lido na primeira vez: depois a vpn-local guarda a própria credencial.
CHAVE=

# Nome desta instalação (aparece em "Meu laboratório > Instalações")
NOME=Scada-LTS (Docker)

# Porta do Scada-LTS no seu computador. Mude (ex.: 8088) se a 8080 estiver ocupada.
SCADA_PORT=8080
